{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ .Site.Title }}</title>
    <description>{{ .Site.Params.description }}</description>
    <link>{{ .Site.BaseURL }}</link>
    <image>
      <url>{{ .Site.BaseURL }}favicon.png</url>
      <title>{{ .Site.Title }}</title>
      <link>{{ .Site.BaseURL }}</link>
    </image>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    <ttl>60</ttl>
    {{ $posts := where .Site.RegularPages "Section" "posts" }}
    {{ $filtered := slice }}
    {{ range sort $posts "Date" "desc" }}
      {{ $tags := .Params.tags | default (slice) }}
      {{ if and (.Params.include_in_feed) (not (in $tags "dispatch")) }}
        {{ $filtered = $filtered | append . }}
      {{ end }}
    {{ end }}
    {{ range first 20 $filtered }}
      <item>
        <title>{{ .Title }}</title>
        <description>{{ .Summary | plainify }}</description>
        <link>{{ .Permalink }}</link>
        <guid isPermaLink="false">{{ .File.UniqueID }}</guid>
        <category>{{ .Params.primary_tag }}</category>
        <dc:creator>{{ .Params.author_name | default "Brian Bailey" }}</dc:creator>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        {{ with .Params.feature_image }}<media:content url="{{ . }}" medium="image"/>{{ end }}
        <content:encoded>{{ printf "<![CDATA[ %s ]]>" .Content | safeHTML }}</content:encoded>
      </item>
    {{ end }}
  </channel>
</rss>
