<article class="article article--excerpt">
  <header class="article__header article__header--compact">
    <h2 class="article__title">
      <a class="article__link no-underline" href="{{url}}">{{title}}</a>
    </h2>
    <time class="article__date" datetime="{{date format="YYYY-MM-DD"}}">{{date}}</time>
  </header>
  <div class="article__excerpt">{{excerpt}}&hellip;</div>
</article>
