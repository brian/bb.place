<article class="article article--mini">
  <header class="article__header article__header--compact">
    <h3 class="article__title">
      <a class="article__link no-underline" href="{{url}}">{{title}}</a>
    </h3>
    <time class="article__date" datetime="{{date published_at format="YYYY-MM-DD"}}">
      {{date published_at format="MMM DD"}}
    </time>
  </header>
</article>
