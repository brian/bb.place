<nav class="nav nav--{{#if isSecondary}}secondary{{else}}primary{{/if}}">
  {{#unless isSecondary}}
    <a class="nav__home no-underline" href="{{@site.url}}">
      {{> "logo"}}
    </a>
    <button class="nav__toggle button-reset" aria-label="Menu">Menu</button>
  {{/unless}}
  <ul class="nav__list">
    {{#foreach navigation}}
      <li class="nav__item">
        <a class="nav__link nav__link--{{slug}} {{#if current}}nav__link--current{{/if}} no-underline" href="{{url absolute="true"}}">{{label}}</a>
      </li>
    {{/foreach}}
    {{#unless isSecondary}}
      <li class="nav__footer">
        <a class="nav__footer-link" rel="me" href="https://twitter.com/bb">@bb</a>
        <a class="nav__footer-link" href="https://bb.place/rss">RSS</a>
        <div class="nav__footer-name">Brian Bailey &copy; {{date format="YYYY"}}</div>
      </li>
    {{/unless}}
  </ul>
</nav>
