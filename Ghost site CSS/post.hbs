{{!< default}}

{{#post}}
  {{#contentFor "main_class"}} article {{post_class}}{{/contentFor}}
  {{> "article-header"}}
  {{content}}
  {{#contentFor "related"}}{{> "related"}}{{/contentFor}}

  {{!--

  Note: Commenting out the pager for the time being since there's some kookoo
  bananas behavior where the pager shows up on all posts until refreshing

  {{#has primary_tag="dispatch"}}
    {{#contentFor "pager"}}{{> "pager"}}{{/contentFor}}
  {{/has}}

  --}}
{{/post}}
